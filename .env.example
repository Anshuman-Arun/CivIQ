# Server-side keys used by the Vercel Functions in /api.
# Never prefix these with VITE_ in a deployed project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENSTATES_API_KEY=
CONGRESS_API_KEY=

# Optional comma-separated Legistar client names for local calendars.
# CivIQ also tries the normalized city name as a best-effort client.
LEGISTAR_CLIENTS=reno
